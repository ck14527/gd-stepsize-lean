/-- Certified by integer squaring, not by decimal evaluation. -/
theorem corner_rho_interval : rho ∈ Icc (301776695296636881100211/125000000000000000000000:ℝ) (2414213562373095048801689/1000000000000000000000000:ℝ) := by
  have hs := Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num)
  have hn := Real.sqrt_nonneg 2
  unfold rho
  constructor <;> nlinarith [hs,hn]

theorem corner_U_1 : U 1 ∈ Icc (1:ℝ) 1 := by simp

theorem corner_U_2 : U 2 ∈ Icc (301776695296636881100211/125000000000000000000000:ℝ) (2414213562373095048801689/1000000000000000000000000:ℝ) := by
  have h := positive_product_interval rho (U 1) (301776695296636881100211/125000000000000000000000:ℝ) (2414213562373095048801689/1000000000000000000000000:ℝ) (1:ℝ) (1:ℝ) (by norm_num) (by norm_num) corner_rho_interval corner_U_1
  rw [show 2=2*1 by norm_num,U_even]
  constructor
  · apply le_trans _ h.1
    norm_num
  · apply le_trans h.2
    norm_num

